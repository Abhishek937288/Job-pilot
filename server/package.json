{
  "name": "@jobpilot/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "dev:worker": "tsx watch --clear-screen=false src/worker.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').writeFileSync('dist/package.json','{\\\"type\\\":\\\"module\\\"}')\"",
    "start": "node dist/src/index.js",
    "start:worker": "node dist/src/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@jobpilot/shared": "0.1.0",
    "@json2csv/plainjs": "7.0.8",
    "bullmq": "6.3.15",
    "cheerio": "1.2.0",
    "cookie-parser": "1.4.7",
    "dotenv": "17.2.3",
    "exceljs": "4.4.0",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "jsonwebtoken": "9.0.3",
    "mammoth": "1.13.0",
    "mongoose": "9.11.2",
    "multer": "2.5.0",
    "openai": "7.34.0",
    "pdf-parse": "2.4.5",
    "pdfjs-dist": "5.4.296",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.3.0",
    "@types/supertest": "7.2.1",
    "pino-pretty": "13.1.2",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "vitest": "5.0.4"
  }
}

{
  "name": "@jobpilot/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts | pino-pretty --colorize --translateTime SYS:HH:MM:ss --ignore pid,hostname",
    "dev:worker": "tsx watch --clear-screen=false src/worker.ts | pino-pretty --colorize --translateTime SYS:HH:MM:ss --ignore pid,hostname",
    "start": "tsx src/index.ts",
    "start:worker": "tsx src/worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:test": "tsx src/scripts/with-test-db.ts prisma migrate deploy",
    "db:test:create": "tsx src/scripts/create-test-db.ts",
    "llm:smoke": "tsx src/scripts/llm-smoke.ts",
    "postinstall": "prisma generate",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "ats:smoke": "tsx src/scripts/ats-smoke.ts"
  },
  "dependencies": {
    "@jobpilot/shared": "0.1.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "cheerio": "1.2.0",
    "express": "5.3.0",
    "mammoth": "1.13.0",
    "multer": "2.5.0",
    "openai": "7.45.1",
    "pdf-parse": "2.4.5",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/pg": "8.23.1",
    "pino-pretty": "13.2.0",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  }
}

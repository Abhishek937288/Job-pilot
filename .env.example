# JobPilot configuration. Copy to `.env` in the repo root and fill in.
# The server (API + worker) and Prisma CLI read this file; the web app reads only API_INTERNAL_URL.
# Nothing here is ever exposed to the browser bundle (no NEXT_PUBLIC_* variables).

# ---------------------------------------------------------------- runtime
# development | test | production. In production the session cookie is marked Secure (HTTPS only).
NODE_ENV=development
# Port the Express API listens on.
PORT=4000
# Port the Next.js app listens on (npm run dev / start).
WEB_PORT=3000
# pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Express "trust proxy". "loopback" trusts only the local Next.js rewrite proxy, so req.ip is the
# real client IP (used by the login rate limiter). Use a hop count or "true" behind other proxies.
TRUST_PROXY=loopback

# ---------------------------------------------------------------- web -> API
# Where the Next.js server forwards /api/* requests (server-side rewrite; never sent to the browser).
# Read when `next dev` starts and baked in at `next build` time: rebuild after changing it for `next start`.
API_INTERNAL_URL=http://localhost:4000

# ---------------------------------------------------------------- database (docker-compose.yml)
POSTGRES_USER=jobpilot
POSTGRES_PASSWORD=jobpilot
POSTGRES_DB=jobpilot
POSTGRES_PORT=5432
# Must include ?schema=public: Prisma only manages `public`; pg-boss owns the `pgboss` schema.
# App queries. On Neon use the pooled ("-pooler") endpoint.
DATABASE_URL=postgresql://jobpilot:jobpilot@localhost:5432/jobpilot?schema=public
# Direct (non-pooled) endpoint, used by `prisma migrate` and pg-boss (advisory locks, LISTEN/NOTIFY
# don't work through PgBouncer transaction mode). On Neon: same host without "-pooler".
# Optional locally; defaults to DATABASE_URL.
DIRECT_DATABASE_URL=postgresql://jobpilot:jobpilot@localhost:5432/jobpilot?schema=public
# Separate database for integration tests (direct endpoint). Create with `npm run db:test:create`.
TEST_DATABASE_URL=postgresql://jobpilot:jobpilot@localhost:5432/jobpilot_test?schema=public

# ---------------------------------------------------------------- auth (single user)
# Login password, at least 8 characters.
APP_PASSWORD=change-me-please
# HMAC key for the session cookie, at least 32 characters. Generate: openssl rand -base64 48
SESSION_SECRET=replace-with-output-of-openssl-rand-base64-48
# Session lifetime in hours (default 168 = 7 days).
SESSION_TTL_HOURS=168
# Failed login attempts allowed per IP within the window before returning HTTP 429.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# ---------------------------------------------------------------- OpenAI (server-side only)
OPENAI_API_KEY=sk-...
# Model used for extraction and other high-volume calls. Must support Structured Outputs.
OPENAI_MODEL_CHEAP=
# Model used for quality-sensitive calls (resume keyword suggestions). Must support Structured Outputs.
OPENAI_MODEL_STRONG=

# ---------------------------------------------------------------- job search (Phase 2)
# Serper.dev key (https://serper.dev). Without it, search runs fail immediately; nothing else is affected.
SERPER_API_KEY=
# Google country code sent as `gl` on every Serper query.
SERPER_GL=in
# Hard cap on queries per run (1 page each, so at most this many credits per run plus one retry each).
SERPER_MAX_QUERIES_PER_RUN=15
# Credits your Serper account had when you started using JobPilot. Remaining credits are estimated as
# this minus the credits logged on every search run. Update it if you top up.
SERPER_CREDITS_TOTAL=2500
# Show a warning in the UI when the estimated remaining credits drop below this.
SERPER_LOW_CREDIT_WARNING=250
# For Serper hits on Greenhouse/Lever/Ashby, read the job's public ATS JSON to get exact title/location
# (no page scraping). Set to false to store only what the search result contains.
ATS_ENRICH_SERPER_HITS=true
# Minimum milliseconds between requests to the same host (ATS APIs).
HTTP_MIN_INTERVAL_MS=500

# ---------------------------------------------------------------- resume handling
# Upload size limit in MB (capped at 5).
MAX_UPLOAD_MB=5
# Below this many non-whitespace characters the file is treated as scanned/image-only:
# status NEEDS_REVIEW and no LLM call is made.
RESUME_MIN_TEXT_CHARS=200
# Resume text is truncated to this many characters before being sent to the LLM.
RESUME_MAX_TEXT_CHARS=40000

# JobPilot configuration. Copy to `.env` in the repo root and fill in the REQUIRED values.
# The API, the worker and the scripts read this file; the web app reads only API_INTERNAL_URL and WEB_PORT.
# Nothing here is sent to the browser.

# ---------------------------------------------------------------- runtime
NODE_ENV=development
# Express API port, and the web app's port and public origin (used for the Origin check and OAuth redirects).
PORT=4000
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
# Where Next.js forwards /api/* (server-side rewrite).
API_INTERNAL_URL=http://localhost:4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Express "trust proxy". "loopback" trusts only the local Next.js proxy, so req.ip is the real client IP.
TRUST_PROXY=loopback

# ---------------------------------------------------------------- data (local MongoDB and Redis)
MONGODB_URI=mongodb://localhost:27017/jobpilot
REDIS_URL=redis://localhost:6379
# Integration tests only (`npm run test:integration`): the database is wiped.
TEST_MONGODB_URI=mongodb://localhost:27017/jobpilot_test
TEST_REDIS_URL=redis://localhost:6379/15

# ---------------------------------------------------------------- auth
# REQUIRED. HMAC key for session JWTs, at least 32 characters: openssl rand -base64 48
SESSION_SECRET=
SESSION_TTL_DAYS=7
# Guests get a random session; all their data is deleted after GUEST_TTL_DAYS unless they sign up.
GUEST_ENABLED=true
GUEST_TTL_DAYS=7
# Optional Google sign-in. Register this redirect URI in the Google Cloud console:
#   http://localhost:3000/api/auth/google/callback   (defaults to WEB_ORIGIN + /api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ---------------------------------------------------------------- per-user limits
MAX_PROFILES_PER_USER=5
# Searches per UTC day (the first search after an upload counts).
DAILY_SEARCH_QUOTA=20
GUEST_DAILY_SEARCH_QUOTA=5
RATE_LIMIT_PER_MINUTE=120
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MINUTES=15

# ---------------------------------------------------------------- OpenAI
# REQUIRED. Used for resume extraction, query generation, ranking and web search.
OPENAI_API_KEY=
# Extraction, queries and ranking. Must support Structured Outputs (and PDF input for the scan fallback).
OPENAI_MODEL_CHEAP=gpt-4o-mini
# Top-N explanations only.
OPENAI_MODEL_STRONG=gpt-4o
# Must support the web_search tool.
OPENAI_MODEL_WEB_SEARCH=gpt-4o-mini
# Prices in USD, used only for the cost-per-search measurement. Check current pricing.
PRICE_CHEAP_INPUT_PER_M=0.15
PRICE_CHEAP_OUTPUT_PER_M=0.6
PRICE_STRONG_INPUT_PER_M=2.5
PRICE_STRONG_OUTPUT_PER_M=10
WEB_SEARCH_COST_PER_CALL=0.025
# Ranking: jobs per LLM call, max jobs ranked per run, and how many top results get a stronger-model explanation (0 = off).
RANK_BATCH_SIZE=10
RANK_MAX_JOBS=60
EXPLAIN_TOP_N=10

# ---------------------------------------------------------------- JSearch (Google for Jobs data)
# From https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch (200 free requests/month).
# Without a key the JSearch source is skipped and reported as failed on each run; other sources still work.
JSEARCH_API_KEY=
JSEARCH_BASE_URL=https://jsearch.p.rapidapi.com
# Search endpoint. JSearch replaced /search with /search-v2.
JSEARCH_SEARCH_PATH=/search-v2
# x-rapidapi-host header. Leave empty for a direct OpenWeb Ninja key (sent as x-api-key).
JSEARCH_HOST=jsearch.p.rapidapi.com
# all | today | 3days | week | month
JSEARCH_DATE_POSTED=month
JSEARCH_COST_PER_REQUEST=0.0025
# Results are cached (shared across users) by normalized query + location.
JSEARCH_CACHE_HOURS=6

# ---------------------------------------------------------------- OpenAI web search (fallback + discovery)
WEB_SEARCH_ENABLED=true
# Runs only when fewer jobs than this survive pre-filtering.
WEB_SEARCH_MIN_RESULTS=10
WEB_SEARCH_MAX_JOBS=10
# Comma-separated allowed domains for web_search.
WEB_SEARCH_DOMAINS=boards.greenhouse.io,job-boards.greenhouse.io,jobs.lever.co,jobs.ashbyhq.com,apply.workable.com,jobs.smartrecruiters.com

# ---------------------------------------------------------------- watchlist and fetching
WATCHLIST_REFRESH_HOURS=6
# Jobs posted longer ago than this are hidden.
JOB_MAX_AGE_DAYS=30
# Minimum gap between requests to the same host.
HTTP_MIN_INTERVAL_MS=1000
HTTP_USER_AGENT=JobPilotBot/0.1 (+personal job search assistant)
# Search runs processed in parallel by one worker.
SEARCH_CONCURRENCY=2

# ---------------------------------------------------------------- resume handling
MAX_UPLOAD_MB=5
# Fewer non-whitespace characters than this = scanned PDF.
RESUME_MIN_TEXT_CHARS=200
RESUME_MAX_TEXT_CHARS=30000
# Send scanned PDFs to the vision-capable model instead of rejecting them.
VISION_FALLBACK_ENABLED=true

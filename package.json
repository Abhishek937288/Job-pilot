{
  "name": "jobpilot",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "postinstall": "npm run build --workspace shared",
    "dev": "concurrently -k -n shared,api,worker,web -c yellow,cyan,magenta,green \"npm run dev -w shared\" \"npm run dev -w server\" \"npm run dev:worker -w server\" \"npm run dev -w web\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace server",
    "test:integration": "npm run test:integration --workspace server"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "5.9.3",
    "concurrently": "9.2.1"
  }
}
